<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Учебный проект: экспериментальная оценка временной сложности алгоритмов.

    ВАЖНО ДЛЯ КОРРЕКТНЫХ ИЗМЕРЕНИЙ:
    запускать проект в конфигурации Release (dotnet run -c Release или
    Visual Studio -> конфигурация Release). В Debug JIT-компилятор не выполняет
    оптимизации, и результаты бенчмарка будут искажены.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ComplexityResearch</RootNamespace>
    <AssemblyName>ComplexityResearch</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: требуем только XML-документацию для ключевых публичных членов. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
  </ItemGroup>

</Project>
